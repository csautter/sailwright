{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enableAllProjectMcpServers": false,
  "disableAllHooks": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash(go version:*)",
      "Bash(go env:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(shasum:*)",
      "Bash(sha256sum:*)",
      "Bash(uname:*)",
      "Bash(sw_vers:*)",
      "Bash(./sailwright version:*)",
      "Bash(./sailwright build:*)",
      "Bash(./sailwright create:*)",
      "Bash(./sailwright start:*)",
      "Bash(./sailwright stop:*)",
      "Bash(./sailwright destroy:*)",
      "Bash(./sailwright vm:*)",
      "Bash(virsh --connect qemu:///system list *)",
      "Bash(virsh --connect qemu:///system list)",
      "Bash(virsh --connect qemu:///session list *)",
      "Bash(virsh --connect qemu:///session list)",
      "Bash(virsh version:*)",
      "Bash(tart list:*)",
      "Bash(tart --version:*)"
    ],
    "ask": [
      "Bash(tart clone:*)",
      "Bash(tart run:*)",
      "Bash(tart ip:*)",
      "Bash(tart stop:*)",
      "Bash(tart delete:*)",
      "Bash(utmctl:*)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * push)"
    ],
    "deny": [
      "Bash(*sailwright* provision local*)",
      "Bash(*sailwright* install*)",
      "Bash(*sailwright* self-update*)",
      "Bash(*sailwright* destroy all*)",
      "Bash(*sailwright* stop all*)",
      "Bash(sudo:*)",
      "Bash(* sudo *)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(runas:*)",
      "Bash(*Start-Process*-Verb RunAs*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(choco:*)",
      "Bash(winget:*)",
      "Bash(git * push *--force*)",
      "Bash(git * push *-f *)",
      "Bash(git * push *-f)",
      "Bash(git * push *--force-with-lease*)",
      "Bash(git push *--force*)",
      "Bash(git push *-f *)",
      "Bash(git push *-f)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git -c *)",
      "Bash(git * -c *)",
      "Bash(git *--exec-path*)",
      "Bash(git *--upload-pack*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(*--dangerously-skip-permissions*)",
      "Bash(*--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(*--yolo*)",
      "Bash(*--bypass-approvals*)",
      "Bash(tart run *tahoe-runner*)",
      "Bash(tart delete *tahoe-runner*)",
      "Bash(tart set *tahoe-runner*)",
      "Bash(tart stop *tahoe-runner*)",
      "Bash(virsh * undefine *)",
      "Bash(virsh * undefine)",
      "Bash(virsh * destroy *)",
      "Bash(virsh * destroy)",
      "Bash(virsh undefine:*)",
      "Bash(virsh destroy:*)",
      "Bash(gh pr:*)",
      "Bash(gh workflow:*)",
      "Bash(gh release:*)",
      "Bash(*security find-generic-password*)",
      "Bash(*security find-internet-password*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)"
    ]
  }
}
