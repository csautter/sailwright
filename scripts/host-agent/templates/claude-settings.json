      "Bash(*/claude.bat *)",
      "Bash(codex:*)",
      "Bash(*/codex)",
      "Bash(*/codex *)",
      "Bash(codex.exe:*)",
      "Bash(*/codex.exe)",
      "Bash(*/codex.exe *)",
      "Bash(codex.cmd:*)",
      "Bash(*/codex.cmd)",
      "Bash(*/codex.cmd *)",
      "Bash(codex.bat:*)",
      "Bash(*/codex.bat)",
      "Bash(*/codex.bat *)"
    ]
  }
}
