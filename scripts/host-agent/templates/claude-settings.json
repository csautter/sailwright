      "Bash(*sailwright* install*)",
      "Bash(sailwright update)",
      "Bash(sailwright update *)",
      "Bash(*/sailwright update)",
      "Bash(*/sailwright update *)",
      "Bash(sailwright.exe update)",
      "Bash(sailwright.exe update *)",
      "Bash(*/sailwright.exe update)",
      "Bash(*/sailwright.exe update *)",
      "Bash(*sailwright* self-update*)",
      "Bash(*sailwright* destroy all*)",
      "Bash(*sailwright* stop all*)",
      "Bash(sudo:*)",
      "Bash(* sudo *)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(runas:*)",
      "Bash(*Start-Process*-Verb RunAs*)",
      "Bash(apt:*)",
      "Bash(apt-get:*)",
      "Bash(brew install:*)",
      "Bash(brew uninstall:*)",
      "Bash(choco:*)",
      "Bash(winget:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(*--dangerously-skip-permissions*)",
      "Bash(*--dangerously-bypass-approvals-and-sandbox*)",
      "Bash(*--yolo*)",
      "Bash(*--bypass-approvals*)",
      "Bash(tart run *tahoe-runner*)",
      "Bash(tart delete *tahoe-runner*)",
      "Bash(tart set *tahoe-runner*)",
      "Bash(tart stop *tahoe-runner*)",
      "Bash(virsh * undefine *)",
      "Bash(virsh * undefine)",
      "Bash(virsh * destroy *)",
      "Bash(virsh * destroy)",
      "Bash(virsh undefine:*)",
      "Bash(virsh destroy:*)",
      "Bash(*security find-generic-password*)",
      "Bash(*security find-internet-password*)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.kube/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/Library/Keychains/**)",
      "Edit(~/.ssh/**)",
      "Write(~/.ssh/**)",
      "Bash(git:*)",
      "Bash(*/git)",
      "Bash(*/git *)",
      "Bash(git.exe:*)",
      "Bash(*/git.exe)",
      "Bash(*/git.exe *)",
      "Bash(git.cmd:*)",
      "Bash(*/git.cmd)",
      "Bash(*/git.cmd *)",
      "Bash(git.bat:*)",
      "Bash(*/git.bat)",
      "Bash(*/git.bat *)",
      "Bash(gh:*)",
      "Bash(*/gh)",
      "Bash(*/gh *)",
      "Bash(gh.exe:*)",
      "Bash(*/gh.exe)",
      "Bash(*/gh.exe *)",
      "Bash(gh.cmd:*)",
      "Bash(*/gh.cmd)",
      "Bash(*/gh.cmd *)",
      "Bash(gh.bat:*)",
      "Bash(*/gh.bat)",
      "Bash(*/gh.bat *)",
      "Bash(claude:*)",
