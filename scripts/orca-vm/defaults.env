# Repository defaults for the ORCA_DOCKER_* variables (see docker-lib.sh);
# the environment and the gitignored local.env win.
#
# .devcontainer/github-auth.sh already shares the GitHub token with every Orca
# workspace through the devcontainer lifecycle (initializeCommand and
# postStartCommand), with the same token file and opt-in as the devcontainer.
ORCA_DOCKER_GITHUB_AUTH=none
