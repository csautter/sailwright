{
  "name": "Go",
  "dockerComposeFile": [
    "compose.yaml",
    ".generated/compose.local.yaml"
  ],
  "service": "dev",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "GOTOOLCHAIN": "auto",
    "CLAUDE_CONFIG_DIR": "/root/.claude"
  },
  "initializeCommand": "bash .devcontainer/initialize-host.sh",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "HashiCorp.HCL",
        "HashiCorp.terraform",
        "openai.chatgpt",
        "ms-azuretools.vscode-azurefunctions",
        "emeraldwalk.runonsave",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "root",
  "containerUser": "root",
  "updateRemoteUserUID": true,
  "postCreateCommand": "go install ./cmd/sailwright-gateway",
  "postStartCommand": "if [ -f /root/.codex-auth.json ]; then mkdir -p /root/.codex && ln -sfn /root/.codex-auth.json /root/.codex/auth.json; fi; nohup bash .devcontainer/install-extensions.sh >/tmp/install-extensions.log 2>&1 &"
}
