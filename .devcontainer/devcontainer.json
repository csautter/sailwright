{
  "name": "Go",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "GOTOOLCHAIN": "auto"
  },
  "remoteEnv": {
    "SAILWRIGHT_GATEWAY_TOKEN": "${localEnv:SAILWRIGHT_GATEWAY_TOKEN}",
    "SAILWRIGHT_GATEWAY_URL": "${localEnv:SAILWRIGHT_GATEWAY_URL}"
  },
  "runArgs": ["--add-host=host.docker.internal:host-gateway"],
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.agents/skills,target=/root/.agents/skills,type=bind,consistency=cached",
    "source=skills-vscode-server-data,target=/root/.vscode-server/data,type=volume",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.agents/skills,target=/root/.claude/skills,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex/skills,target=/root/.codex/skills,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.agents/agents,target=/root/.copilot/agents,type=bind,consistency=cached",
    "source=skills-vscode-server-extensions,target=/root/.vscode-server/extensions,type=volume",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.codex/auth.json,target=/root/.codex-auth.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude-devcontainer,target=/root/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.local/share/opencode,target=/root/.local/share/opencode,type=bind,consistency=cached",
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/Projects/sailwright-plans,target=/workspaces/sailwright-plans,type=bind,consistency=cached"
  ],
  "features": {
    "ghcr.io/devcontainers/features/python:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "HashiCorp.HCL",
        "HashiCorp.terraform",
        "openai.chatgpt",
        "ms-azuretools.vscode-azurefunctions",
        "emeraldwalk.runonsave",
        "anthropic.claude-code"
      ]
    }
  },
  "remoteUser": "root",
  "containerUser": "root",
  "updateRemoteUserUID": true,
  "postStartCommand": "mkdir -p /root/.codex && ln -sfn /root/.codex-auth.json /root/.codex/auth.json ; nohup bash .devcontainer/install-extensions.sh >/tmp/install-extensions.log 2>&1 &"
}
