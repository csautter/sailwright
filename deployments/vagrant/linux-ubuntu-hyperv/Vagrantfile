Vagrant.configure("2") do |config|
  if ENV["VAGRANT_INSTANCE_HOSTNAME"]
    config.vm.hostname = ENV["VAGRANT_INSTANCE_HOSTNAME"]
  end
  config.vm.box = ENV.fetch("VAGRANT_BOX_NAME", "linux-ubuntu-server-packer")
  hyperv_switch = ENV.fetch("VAGRANT_HYPERV_SWITCH", "Default Switch")
  config.vm.network "public_network", bridge: hyperv_switch
  # This image is intended to run without host folder mounts.
  # Prevent Vagrant from touching /etc/fstab for synced folders.
  config.vm.allow_fstab_modification = false
  
  config.vm.provider "hyperv" do |h|
    h.vmname = ENV.fetch("VAGRANT_VM_NAME", "linux-ubuntu-packer")
    h.memory = ENV.fetch("VAGRANT_VM_MEMORY_MB", "8192").to_i
    h.cpus = ENV.fetch("VAGRANT_VM_CPUS", "4").to_i
    # Hosts that are themselves nested (e.g. Windows in a KVM guest) cannot
    # expose virtualization extensions; sailwright sets this to false when
    # Hyper-V refuses to start the VM for that reason.
    nested = ENV.fetch("VAGRANT_HYPERV_NESTED_VIRTUALIZATION", "true").strip.downcase
    h.enable_virtualization_extensions = !%w[0 false no off].include?(nested)
    # Wait longer than Vagrant's 120s default for the guest to report its IP;
    # desktop images can take longer to bring up networking on first boot.
    h.ip_address_timeout = ENV.fetch("VAGRANT_IP_ADDRESS_TIMEOUT", "600").to_i
  end

  config.vm.communicator = "ssh"
  config.vm.guest = :linux
  # Allow slower first boots on Hyper-V images before Vagrant gives up.
  config.vm.boot_timeout = ENV.fetch("VAGRANT_BOOT_TIMEOUT", "1800").to_i

  # Optional: Set up SSH credentials if needed
  config.ssh.username = "packer"
  config.ssh.password = "P@ssw0rd!"
  # The image has no passwordless sudo. Vagrant feeds privileged scripts (such as
  # "Setting hostname" for named instances) to the shell on stdin, so `sudo -S`
  # cannot be used; authenticate through a temporary askpass helper instead.
  # mktemp creates the helper with mode 0600 before the password is written; the
  # EXIT trap removes it on every exit path, and the signal traps turn HUP, INT
  # and TERM into exits so the EXIT trap runs in bash and dash alike. The shell
  # exits with sudo's status, which is the status of the piped script.
  config.ssh.sudo_command = %q{askpass=$(mktemp) || exit; trap 'rm -f "$askpass"' EXIT; trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM; printf '#!/bin/sh\necho %s\n' "'P@ssw0rd!'" > "$askpass" && chmod 700 "$askpass" && SUDO_ASKPASS="$askpass" sudo -A -E -H %c}

  # Disable the default root synced folder.
  config.vm.synced_folder ".", "/vagrant", id: "vagrant-root", disabled: true
end
