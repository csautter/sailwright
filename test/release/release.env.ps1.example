# Copy to test\release\release.env.ps1 (git-ignored) and adjust. Dot-sourced by windows.ps1.
$env:RT_PLAN = 'windows-physical'        # or windows-vm
$env:RT_DISPOSABLE = '0'                 # 1 only on a throwaway VM: unlocks install and provision-local
$env:RT_EXPECT_COMMIT = ''              # optional: origin/main SHA shared by all plans of a test round
# $env:RT_TARGET = 'ubuntu/server/amd64'
# $env:RT_APPDATA = 'default'            # default: isolated app data under the run directory
# $env:RT_ALLOW_INSTALL = '1'            # allow the install phase on a physical test host
# $env:RT_WITH_HYPERV = '1'              # install --hyperv --vagrant in the install phase
# $env:RT_WITH_WINDOWS = '1'             # windows11 Hyper-V build and WinRM access (hours)
# $env:CYGWIN_BASH_PATH = 'C:\cygwin64\bin\bash.exe'
# $env:RT_CANCEL_TARGET = 'ubuntu/desktop/amd64/hyperv'
# $env:RT_FULL_MATRIX = '1'
# $env:RT_RELEASE_TAG = 'v0.27.0'
# $env:RT_UPDATE_FROM = 'v0.27.0'
# $env:RT_GATEWAY_PORT = '7399'
# $env:RT_GATEWAY_START_TIMEOUT = '300'   # seconds to wait until the gateway listens
