# Copy to test/release/release.env (git-ignored) and adjust. Sourced by unix.sh.
# The plan this run belongs to: macos-physical, macos-vm, ubuntu-physical, ubuntu-vm.
RT_PLAN=ubuntu-physical
# 1 only on a throwaway VM: unlocks install and provision-local.
RT_DISPOSABLE=0
# The candidate is the unreleased origin/main (checked by preflight). Optionally pin the
# origin/main SHA recorded at the start of a test round so all six plans test the same commit.
RT_EXPECT_COMMIT=
# Primary VM target (default ubuntu/server/<host arch>).
#RT_TARGET=ubuntu/server/arm64
# Isolated app data under the run directory (default) or "default" for the normal directories.
#RT_APPDATA=default
# Pull this OCI image instead of building, and test interrupted pulls in the build phase.
#RT_PULL_REF=ghcr.io/csautter/ubuntu-24:server-arm64-linux-build
# 1 for targets on bridged/unknown networks (shipped UTM templates on macOS).
#RT_ALLOW_INSECURE_CREDENTIALS=1
# Target for the guest-security-guard scenario (bridged/unknown planned network).
#RT_GUARD_TARGET=ubuntu/server/arm64
# Target whose build gets cancelled (must not have a complete artifact).
#RT_CANCEL_TARGET=ubuntu/desktop/arm64
# Post-release: released tag to install, and an older release (>= v0.27.0) to update from.
#RT_RELEASE_TAG=v0.27.0
#RT_UPDATE_FROM=v0.27.0
# Long optional parts.
#RT_WITH_WINDOWS=1        # windows11 builds, virtio-win cache, libvirt enlightenments
#RT_FULL_MATRIX=1         # vm-lifecycle-<os> for every VM option of this host
#RT_SKIP_PACKER_INTERRUPT=1
# provision-interactive extras (fresh hosts only).
#RT_JAVA_FRESH=1          # no Temurin installed yet
#RT_BREW_FRESH=1          # Intel Mac without Homebrew
#RT_GATEWAY_PORT=7399
#RT_LIBVIRT_URI=qemu:///system
