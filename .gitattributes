# Keep LF for files executed inside Linux containers or by bash on Windows
# hosts, even when a Windows checkout uses core.autocrlf=true.
*.sh text eol=lf
.devcontainer/** text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf

# Orca recipe entry points: the extension-less sh script keeps LF, the
# cmd.exe batch files (Windows) keep CRLF.
scripts/orca-vm/recipe text eol=lf
*.cmd text eol=crlf
